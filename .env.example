# Smart Vision Guide - Environment Configuration
# Copy this file to .env and fill in your settings

# ============================================
# ONLINE AI (Azure Computer Vision) - For OCR and Search modes
# ============================================
AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_VISION_KEY=your_azure_vision_key_here

# ============================================
# GEMINI AI - For Describe mode (Scene Description)
# ============================================
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# OFFLINE / LOCAL VISION
# ============================================
LOCAL_VISION_ONLY=false
LOCAL_MODEL_DIR=models

# MobileNet-SSD (object detector)
OBJECT_DNN_PROTO=models/mobilenet_ssd_deploy.prototxt
OBJECT_DNN_MODEL=models/mobilenet_ssd.caffemodel
OBJECT_DNN_CONFIDENCE=0.45

# Face detector (DNN)
FACE_DNN_PROTO=models/face_detector_deploy.prototxt
FACE_DNN_MODEL=models/face_detector.caffemodel
FACE_DNN_CONFIDENCE=0.5

# Tesseract OCR
# If empty, system default is used
TESSERACT_CMD=
OCR_TIMEOUT=8

# ============================================
# FACE RECOGNITION (Cloud Only)
# ============================================
# Face processing happens in the cloud - lightweight for Pi Zero 2W
# Get your Codespaces URL from GitHub and make port 5000 PUBLIC
FACE_API_URL=https://effective-giggle-v65xxrrjw54rhwjr7-5000.app.github.dev
FACE_API_TIMEOUT=15

# ============================================
# BUTTON CONFIGURATION (BCM pin numbers)
# ============================================
BUTTON_MODE_PIN=17
BUTTON_SELECT_PIN=27

# ============================================
# ULTRASONIC SENSOR + BUZZER (Obstacle Detection)
# ============================================
# Enable/disable ultrasonic obstacle detection
ENABLE_ULTRASONIC=true

# HC-SR04 Ultrasonic Sensor pins
ULTRASONIC_TRIGGER_PIN=23
ULTRASONIC_ECHO_PIN=24

# Buzzer pin
BUZZER_PIN=25

# Distance thresholds in centimeters
# Alert zone: start beeping
ULTRASONIC_ALERT_DISTANCE=50
# Danger zone: rapid beeping
ULTRASONIC_DANGER_DISTANCE=20

# Check interval in seconds
ULTRASONIC_CHECK_INTERVAL=0.2

# Buzzer frequency in Hz (for PWM buzzer)
BUZZER_FREQUENCY=2000

# ============================================
# CAMERA SETTINGS
# ============================================
CAMERA_WIDTH=512
CAMERA_HEIGHT=384
CAMERA_WARMUP_FRAMES=10
CAMERA_RETRY_ATTEMPTS=3
CAMERA_JPEG_QUALITY=70

# ============================================
# CAPTURE STORAGE (Optional)
# ============================================
SAVE_CAPTURES=false
CAPTURE_DIR=captures
CAPTURE_MAX_FILES=200

# ============================================
# AUDIO / TTS
# ============================================
# TTS_BACKEND: auto | pico2wave | espeak-ng | espeak | gtts
TTS_BACKEND=auto
TTS_RATE=120
TTS_VOICE=en-us+f3
USE_BLUETOOTH_AUDIO=true

# Optional: Auto-connect Bluetooth on boot
BT_DEVICE_MAC=AA:BB:CC:DD:EE:FF

# ============================================
# SEARCH MODE (Speech-to-Text)
# ============================================
STT_BACKEND=auto   # auto | vosk | none
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
VOICE_INPUT_SECONDS=4
VOICE_INPUT_SAMPLE_RATE=16000
# Use "auto" to scan for common items
SEARCH_DEFAULT_QUERY=auto

# ============================================
# NETWORK + TIMEOUTS
# ============================================
REQUEST_TIMEOUT=45
RETRY_ATTEMPTS=2
RETRY_DELAY=2.0
ANALYSIS_TIMEOUT=60

# ============================================
# IMAGE PREPROCESSING
# ============================================
IMAGE_MAX_WIDTH=512
IMAGE_JPEG_QUALITY=60
ENABLE_PREPROCESSING=true

# ============================================
# GPS NAVIGATION + HELP MODE
# ============================================
# Enable GPS-based modes (Navigation and Help)
ENABLE_GPS_MODES=true

# Phyphox app GPS endpoint (phone connected via WiFi hotspot)
# 1. Install Phyphox app on your phone
# 2. Open "Location (GPS)" experiment
# 3. Tap play icon to start recording
# 4. Enable "Allow remote access" in menu
# 5. Note the IP address shown (e.g., 192.168.1.108)
PHYPHOX_URL=http://192.168.1.108:8080/get?lat&lon&v

# Home coordinates (destination for navigation)
# Get your home coordinates from Google Maps
HOME_LAT=27.688441946480275
HOME_LON=85.33542229999999

# ntfy.sh configuration for Help mode
# 1. Install ntfy app on relatives' phones (Android/iOS)
# 2. Subscribe them to this topic name
# 3. When you press Help, they'll get a push notification with your location
NTFY_TOPIC=smart-vision-help-2026

# Relatives list (comma-separated names for notification messages)
RELATIVES=Family Member 1,Family Member 2,Friend

# GPS check interval during navigation (seconds)
GPS_CHECK_INTERVAL=2.0

# Enable/disable individual GPS modes
ENABLE_NAVIGATION_MODE=true
ENABLE_HELP_MODE=true
