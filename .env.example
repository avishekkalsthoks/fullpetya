# Smart Vision Guide - Environment Configuration
# Copy this file to .env and fill in your settings

# ============================================
# ONLINE AI (Azure Computer Vision) - Optional but recommended
# ============================================
AZURE_VISION_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_VISION_KEY=your_azure_vision_key_here

# ============================================
# OFFLINE / LOCAL VISION
# ============================================
LOCAL_VISION_ONLY=false
LOCAL_MODEL_DIR=models

# MobileNet-SSD (object detector)
OBJECT_DNN_PROTO=models/mobilenet_ssd_deploy.prototxt
OBJECT_DNN_MODEL=models/mobilenet_ssd.caffemodel
OBJECT_DNN_CONFIDENCE=0.45

# Face detector (DNN)
FACE_DNN_PROTO=models/face_detector_deploy.prototxt
FACE_DNN_MODEL=models/face_detector.caffemodel
FACE_DNN_CONFIDENCE=0.5

# Tesseract OCR
# If empty, system default is used
TESSERACT_CMD=
OCR_TIMEOUT=8

# ============================================
# FACE RECOGNITION (offline LBPH)
# ============================================
FACE_DB_DIR=faces
FACE_CONFIDENCE_THRESHOLD=80

# ============================================
# BUTTON CONFIGURATION (BCM pin numbers)
# ============================================
BUTTON_MODE_PIN=17
BUTTON_SELECT_PIN=27

# ============================================
# ULTRASONIC SENSOR + BUZZER (Obstacle Detection)
# ============================================
# Enable/disable ultrasonic obstacle detection
ENABLE_ULTRASONIC=true

# HC-SR04 Ultrasonic Sensor pins
ULTRASONIC_TRIGGER_PIN=23
ULTRASONIC_ECHO_PIN=24

# Buzzer pin
BUZZER_PIN=25

# Distance thresholds in centimeters
# Alert zone: start beeping
ULTRASONIC_ALERT_DISTANCE=50
# Danger zone: rapid beeping
ULTRASONIC_DANGER_DISTANCE=20

# Check interval in seconds
ULTRASONIC_CHECK_INTERVAL=0.2

# Buzzer frequency in Hz (for PWM buzzer)
BUZZER_FREQUENCY=2000

# ============================================
# CAMERA SETTINGS
# ============================================
CAMERA_WIDTH=512
CAMERA_HEIGHT=384
CAMERA_WARMUP_FRAMES=10
CAMERA_RETRY_ATTEMPTS=3
CAMERA_JPEG_QUALITY=70

# ============================================
# CAPTURE STORAGE (Optional)
# ============================================
SAVE_CAPTURES=false
CAPTURE_DIR=captures
CAPTURE_MAX_FILES=200

# ============================================
# AUDIO / TTS
# ============================================
# TTS_BACKEND: auto | pico2wave | espeak-ng | espeak | gtts
TTS_BACKEND=auto
TTS_RATE=120
TTS_VOICE=en-us+f3
USE_BLUETOOTH_AUDIO=true

# Optional: Auto-connect Bluetooth on boot
BT_DEVICE_MAC=AA:BB:CC:DD:EE:FF

# ============================================
# SEARCH MODE (Speech-to-Text)
# ============================================
STT_BACKEND=auto   # auto | vosk | none
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
VOICE_INPUT_SECONDS=4
VOICE_INPUT_SAMPLE_RATE=16000
# Use "auto" to scan for common items
SEARCH_DEFAULT_QUERY=auto

# ============================================
# NETWORK + TIMEOUTS
# ============================================
REQUEST_TIMEOUT=45
RETRY_ATTEMPTS=2
RETRY_DELAY=2.0
ANALYSIS_TIMEOUT=60

# ============================================
# IMAGE PREPROCESSING
# ============================================
IMAGE_MAX_WIDTH=512
IMAGE_JPEG_QUALITY=60
ENABLE_PREPROCESSING=true
