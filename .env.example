# Smart Vision Guide - Environment Configuration
# Copy this file to .env and fill in your API credentials

# ============================================
# HUGGING FACE API (for Describe, OCR, Search modes)
# Get your token from: https://huggingface.co/settings/tokens
# ============================================
HF_TOKEN=your_huggingface_token_here
HF_MODEL=allenai/Molmo2-8B:publicai

# ============================================
# FACE++ API (for Face Recognition mode)
# Get your credentials from: https://www.faceplusplus.com/
# Free tier: Unlimited API calls, 3 QPS limit
# ============================================
FACEPP_API_KEY=your_facepp_api_key_here
FACEPP_API_SECRET=your_facepp_api_secret_here

# ============================================
# BUTTON CONFIGURATION (BCM pin numbers)
# ============================================
# Button 1: Power (short press = shutdown, long press = Describe mode)
BUTTON_POWER_PIN=17
# Button 2: OCR mode
BUTTON_OCR_PIN=27
# Button 3: Face recognition mode
BUTTON_FACE_PIN=22
# Button 4: Search mode
BUTTON_SEARCH_PIN=23

# ============================================
# CAMERA SETTINGS
# ============================================
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

# ============================================
# TEXT-TO-SPEECH BACKEND
# Options: 'espeak' (offline, default) or 'gtts' (online, better quality)
# ============================================
TTS_BACKEND=espeak

# ============================================
# FACE DATABASE
# ============================================
FACE_DB_FILE=face_database.json
